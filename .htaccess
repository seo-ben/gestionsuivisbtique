<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquer l'accès direct aux fichiers sensibles (.env, .git, etc.)
    <FilesMatch "^\.(env|git|editorconfig)">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # Rediriger toutes les requêtes vers le dossier public/ de Laravel
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
